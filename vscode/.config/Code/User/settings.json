{
  // jk to escape insert
  "vim.enable": true,
  "vim.insertModeKeyBindings": [
    {
      "before": ["j", "k"],
      "after": ["<Esc>"]
    }
  ],
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": ["<leader>", "f"],
      "commands": ["workbench.action.quickOpen"]
    }
  ],
  "vim.leader": "<space>",

  // Don't grab these, let VSCode own them
  "vim.handleKeys": {
    "<C-p>": false,
    "<C-f>": false,
    "<C-b>": false,
    "<C-d>": false,
    "<C-z>": false,
    "<C-a>": false,
    "<C-`>": false
  },

  // Common VIM settings
  "vim.leader": "<space>",
  "vim.useSystemClipboard": true,
  "vim.hlsearch": true,
  "vim.incsearch": true,
  "vim.smartcase": true,
  "vim.ignorecase": true,

  // Remap key bindings to match LazyVim
"vim.normalModeKeyBindingsNonRecursive": [
    // <leader>e  → file explorer (like :Ex / netrw)
    {
      "before": ["<leader>","e"],
      "commands": ["workbench.view.explorer"]
    },
    // <leader>ff → fuzzy find file (Ctrl+P equivalent)
    {
      "before": ["<leader>","f","f"],
      "commands": ["workbench.action.quickOpen"] 
    },
    // <leader>/ → clear search highlight (:nohl)
    {
      "before": ["<leader>","/"],
      "commands": ["vim.remap"],
      "after": ["<Esc>"] 
    },
  ]
}
